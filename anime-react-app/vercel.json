{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "status": 200, "headers": { "cache-control": "no-cache" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
